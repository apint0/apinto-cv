{% import 'macros.html.j2' as m with context %}<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ site.title }} — COMPLETE</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --navy-900: #0a1730;
      --navy-700: #16305f;
      --accent: #5b9dd9;
      --ink: #16233d;
      --muted: #5c6b85;
      --line: #e3e8f0;
      --bg-soft: #eef2f9;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; }
    body {
      font-family: 'Inter', sans-serif;
      font-size: 9px;
      line-height: 1.5;
      color: var(--ink);
      background: white;
      padding: 28px 26px;
    }

    /* HEADER */
    .header {
      display: grid;
      grid-template-columns: 1fr 95px;
      gap: 14px;
      margin-bottom: 18px;
      align-items: start;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 14px;
    }

    .header-text h1 {
      font-family: 'Fraunces', serif;
      font-size: 22px;
      font-weight: 500;
      margin-bottom: 2px;
      color: var(--navy-900);
    }

    .header-text .title {
      font-size: 9px;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 6px;
    }

    .contact-info {
      font-size: 8px;
      color: var(--muted);
      line-height: 1.5;
    }

    .contact-info span {
      display: block;
    }

    .photo {
      width: 95px;
      height: 95px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid var(--accent);
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }

    /* LINKS */
    .links-row {
      margin-top: 6px;
      font-size: 7px;
    }

    .links-row a {
      color: var(--accent);
      text-decoration: underline;
    }

    /* SUMMARY */
    .summary-panel {
      background: linear-gradient(135deg, rgba(91,157,217,0.08), rgba(91,157,217,0.04));
      border-left: 3px solid var(--accent);
      padding: 9px;
      margin-bottom: 12px;
      border-radius: 3px;
      font-size: 8px;
      line-height: 1.5;
    }

    .summary-panel .label {
      font-size: 7px;
      font-weight: 700;
      color: var(--navy-700);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 4px;
      display: block;
    }

    h2 {
      font-size: 10px;
      font-weight: 700;
      margin-top: 12px;
      margin-bottom: 7px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--navy-900);
      border-bottom: 1px solid var(--line);
      padding-bottom: 3px;
    }

    .section { margin-bottom: 10px; }

    .job {
      margin-bottom: 8px;
      padding-bottom: 7px;
      border-bottom: 1px dotted var(--line);
    }

    .job:last-child {
      border-bottom: none;
    }

    .job-title {
      font-weight: 700;
      font-size: 9px;
      color: var(--navy-900);
    }

    .job-company {
      font-size: 8px;
      color: var(--accent);
      font-weight: 600;
      margin-top: 1px;
    }

    .job-meta {
      font-size: 7px;
      color: var(--muted);
      margin-top: 2px;
      margin-bottom: 4px;
    }

    .job-bullets {
      margin: 0;
      padding-left: 9px;
      list-style: none;
    }

    .job-bullets li {
      margin-bottom: 1px;
      font-size: 8px;
      line-height: 1.3;
    }

    .job-bullets li:before {
      content: "• ";
      color: var(--accent);
      font-weight: 700;
      margin-right: 3px;
    }

    /* PUBLICATIONS */
    .pub-group {
      margin-bottom: 9px;
    }

    .pub-group h3 {
      font-size: 8px;
      font-weight: 700;
      margin-bottom: 4px;
      color: var(--navy-700);
    }

    .pub-tag {
      background: linear-gradient(135deg, var(--accent), #7fc0f5);
      color: white;
      padding: 1px 3px;
      border-radius: 2px;
      font-size: 7px;
      font-weight: 700;
      margin-right: 4px;
    }

    .pubs {
      margin-left: 11px;
      padding-left: 0;
    }

    .pubs li {
      margin-bottom: 2px;
      line-height: 1.3;
      font-size: 8px;
    }

    .me { font-weight: 700; color: var(--accent); }
    .venue { color: var(--muted); font-style: italic; }
    .yr { color: var(--muted); font-weight: 600; }

    /* SKILLS */
    .skill-group {
      margin-bottom: 7px;
    }

    .skill-group-title {
      font-weight: 700;
      font-size: 8px;
      color: var(--navy-700);
      margin-bottom: 3px;
      text-transform: uppercase;
      letter-spacing: 0.4px;
    }

    .skill-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
    }

    .skill-tag {
      background: linear-gradient(135deg, var(--navy-700), #0f2247);
      color: white;
      padding: 1px 5px;
      border-radius: 2px;
      font-size: 7px;
      font-weight: 600;
    }

    @page { size: A4; margin: 15px; }
    @media print { body { padding: 0; } }
  </style>
</head>
<body>

<!-- HEADER WITH PHOTO -->
<div class="header">
  <div class="header-text">
    <div class="title">{{ hero.eyebrow }}</div>
    <h1>{{ hero.name }}</h1>
    <div class="contact-info">
      <span>{{ hero.email }}</span>
      <span>{{ hero.phone }}</span>
      <span>{{ hero.location }}</span>
    </div>
    <div class="links-row">
{% for l in hero.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% if not loop.last %} · {% endif %}{% endfor %}
    </div>
  </div>
  <img class="photo" src="file://{{ site.base_path }}/assets/profile.jpg" alt="{{ hero.name }}" />
</div>

<!-- SUMMARY -->
<div class="summary-panel">
  <span class="label">Professional Summary</span>
  {{ hero.summary }}
</div>

<!-- EXPERIENCE -->
<section class="section">
  <h2>Professional Experience</h2>
{% for g in experience.groups %}
{% for it in g['items'] %}
  <div class="job">
    <div class="job-title">{{ it.role }}</div>
    <div class="job-company">{{ it.org }}</div>
    <div class="job-meta">{{ it.dates }} · {{ it.location }}</div>
    <ul class="job-bullets">
{% for b in it.bullets %}
      <li>{{ b }}</li>
{% endfor %}
    </ul>
  </div>
{% endfor %}
{% endfor %}
</section>

<!-- EDUCATION -->
<section class="section">
  <h2>Education</h2>
{% for it in education['items'] %}
  <div class="job">
    <div class="job-title">{{ it.title }}</div>
    <div class="job-company">{{ it.sub }}</div>
    <div class="job-meta">{{ it.when }}</div>
  </div>
{% endfor %}
</section>

<!-- PUBLICATIONS -->
<section class="section">
  <h2>Publications</h2>
{% for g in publications.groups %}
  <div class="pub-group">
    <h3><span class="pub-tag">{{ g.tag }}</span> {{ g.label }}</h3>
    <ol class="pubs">
{% for it in g['items'] %}
      <li>{{ it.authors | highlight(site.highlight_name) }}{{ '' if it.authors.endswith('.') else '.' }} "{{ it.title }}." <span class="venue">{{ it.venue }}</span>{% if it.details %}, {{ it.details }}{% endif %}, <span class="yr">{{ it.year }}</span>.</li>
{% endfor %}
    </ol>
  </div>
{% endfor %}
</section>

<!-- SKILLS -->
<section class="section">
  <h2>Technical Skills & Research Focus</h2>

  <div class="skill-group">
    <div class="skill-group-title">Programming & Tooling</div>
    <div class="skill-tags">
{% for p in skills.programming %}<span class="skill-tag">{{ p }}</span>{% endfor %}
    </div>
  </div>

  <div class="skill-group">
    <div class="skill-group-title">Strengths</div>
    <div class="skill-tags">
{% for s in skills.strengths %}<span class="skill-tag">{{ s }}</span>{% endfor %}
    </div>
  </div>

  <div class="skill-group">
    <div class="skill-group-title">Areas of Interest</div>
    <div class="skill-tags">
{% for i in skills.interests %}<span class="skill-tag">{{ i }}</span>{% endfor %}
    </div>
  </div>

  <div style="margin-top: 7px; padding-top: 7px; border-top: 1px dotted var(--line); font-size: 8px; font-style: italic; color: var(--muted);">
    <strong style="color: var(--navy-700);">Focus:</strong> {{ skills.focus }}
  </div>
</section>

</body>
</html>
