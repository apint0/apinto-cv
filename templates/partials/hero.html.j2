  <header class="hero">
    <div class="wrap">
     <div class="hero-grid">
      <div>
      <div class="eyebrow">{{ hero.eyebrow }}</div>
      <h1 class="name">{{ hero.name }}</h1>
      <p class="role">{{ hero.role_plain }} &nbsp;·&nbsp; <b>{{ hero.role_bold }}</b></p>
      <p class="summary">
        {{ hero.summary }}
      </p>
      <div class="links">
{% for l in hero.links %}
        <a href="{{ l.url }}" target="_blank" rel="noopener" aria-label="{{ l.label }}">
          {{ m.icon(l.icon) }}
          {{ l.label }}
        </a>
{% endfor %}
      </div>

      <div class="downloads">
        <span class="download-label">Download CV</span>
        <a href="Adriano_Pinto_CV_LITE.pdf" download class="dl-btn dl-lite">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          LITE
        </a>
        <a href="Adriano_Pinto_CV_COMPLETE.pdf" download class="dl-btn dl-complete">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
          COMPLETE
        </a>
      </div>
      </div>
      <img class="hero-photo" src="{{ hero.photo }}" alt="{{ hero.name }}"
           onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'hero-photo hero-monogram',textContent:'{{ hero.initials }}'}))" />
     </div>
    </div>
  </header>
